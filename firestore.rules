rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isStaff() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff';
    }

    // 1. Menu Items collection
    match /menu_items/{itemId} {
      // Public read access for customers and guests to browse the menu
      allow read: if true;

      // Only staff can add, update, or delete menu items
      allow write: if isStaff();
    }

    // 2. Orders collection
    match /orders/{orderId} {
      // Single order lookup (get): Staff, order owner, or guest order tracking
      allow get: if isStaff() || 
        (isAuthenticated() && resource.data.userId == request.auth.uid) || 
        resource.data.userId == 'guest' || 
        !isAuthenticated();

      // Querying order collection (list): Staff can list all orders; customers can list their own
      allow list: if isStaff() || 
        (isAuthenticated() && resource.data.userId == request.auth.uid);

      // Anyone (guest or authenticated customer) can place an order
      // Orders must start with status 'Received'
      allow create: if request.resource.data.status == 'Received';

      // Updates (status changes on Barista Board): Only staff can update orders
      allow update: if isStaff();

      // Only staff can delete orders
      allow delete: if isStaff();
    }

    // 3. Users collection
    match /users/{userId} {
      // Users can read their own profile; Staff can read any user profile
      allow get: if isOwner(userId) || isStaff();
      allow list: if isStaff();

      // Users can create their own profile, but role MUST be 'customer'
      allow create: if isOwner(userId) && 
        (!('role' in request.resource.data) || request.resource.data.role == 'customer');

      // Users can update their profile, but CANNOT elevate their own role to staff
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isStaff();

      // Deleting user profiles
      allow delete: if isOwner(userId) || isStaff();
    }
  }
}

